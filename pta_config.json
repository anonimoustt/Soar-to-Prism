{
  "model_type": "pta",
  "time_scale": 1,
  "time_units": "time_units",
  "constants": {
    "N": 20,
    "max_deadline": 20
  },
  "pta_semantics": {
    "use_init_phase": true,
    "init_phase_var": "init_phase",
    "initialize_label": "initialize",
    "examine_label_prefix": "examine",
    "deadline_label": "deadline_reached",
    "mission_complete_untagged_label": "mission_complete_untagged",
    "deadline_const": "deadline",
    "use_box_const": "use_box",
    "box_accuracy_const": "box_accuracy",
    "attacker_id_var": "state_io_scenario_attacker_id",
    "current_person_id_var": "state_current_person_id",
    "wall_clock_var": "state_wall_clock",
    "apply_miss_rewrite": true,
    "miss_rewrite_from": "state_io_scenario_attacker_id < state_current_person_id",
    "miss_rewrite_to": "state_io_scenario_attacker_id != state_current_person_id",
    "runtime_attacker_sampling": true
  },
  "clocks": {
    "t1": {
      "name": "t1",
      "min_duration": 0,
      "max_duration": 2,
      "bounds": "<=",
      "units": "time_units",
      "label": "reaction_time"
    },
    "init_clock": {
      "name": "init_clock",
      "min_duration": 0,
      "max_duration": 0,
      "bounds": "=",
      "units": "time_units",
      "label": "initialization"
    },
    "wall_clock": {
      "name": "wall_clock",
      "min_duration": 0,
      "max_duration": 100,
      "bounds": "<=",
      "units": "time_units",
      "label": "deadline_tracking"
    }
  },
  "operators": {
    "examine_box": {
      "name": "examine_box",
      "min_time": 1,
      "max_time": 1,
      "resets_clock": true,
      "probability": 1.0,
      "soarRulePatterns": ["propose*examine-box"],
      "resetClocks": ["t1"]
    },
    "examine": {
      "name": "examine",
      "min_time": 1,
      "max_time": 1,
      "resets_clock": true,
      "probability": 1.0,
      "soarRulePatterns": ["propose*examine"],
      "resetClocks": ["t1"]
    },
    "deadline_reached": {
      "name": "deadline_reached",
      "min_time": 0,
      "max_time": 0,
      "resets_clock": false,
      "probability": 1.0,
      "soarRulePatterns": ["propose*deadline-reached"],
      "resetClocks": []
    },
    "mission_complete": {
      "name": "mission_complete",
      "min_time": 0,
      "max_time": 0,
      "resets_clock": false,
      "probability": 1.0,
      "soarRulePatterns": ["propose*mission-complete"],
      "resetClocks": []
    }
  },
  "states": {
    "waiting": {
      "name": "waiting",
      "variable": "action",
      "clock": "t1",
      "time_bound": 1,
      "bounds": "[0..3]"
    },
    "executing": {
      "name": "executing",
      "variable": "action",
      "clock": "t1",
      "time_bound": 1,
      "bounds": "[0..3]"
    },
    "deadline_state": {
      "name": "deadline_state",
      "variable": "satisfy_deadline",
      "clock": "wall_clock",
      "time_bound": 100,
      "bounds": "[0..2]"
    }
  }
}
